# === AzerothCore Auth Database ===
# Use the container name of your MySQL/MariaDB container as the host
DB_HOST=ac-database
DB_PORT=3306
DB_USER=acore
DB_PASSWORD=your_db_password
DB_NAME=acore_auth
CHARS_DB_NAME=acore_characters

# Expansion level for new accounts: 0=Classic, 1=TBC, 2=WotLK, 3=Cata
EXPANSION=2

# === API Security ===
# Shared secret between this proxy and the registration portal.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
API_KEY=generate_a_long_random_string_here

# === Traefik ===
# Hostname Traefik will route to this service
PROXY_HOST=ac-proxy.yourdomain.com

PORT=3001
