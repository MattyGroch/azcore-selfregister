<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>WoW Private Server &mdash; Account Portal</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            discord: '#5865F2',
            'discord-hover': '#4752c4',
            gold: '#c8a96e',
            'gold-light': '#e8c88e',
          },
          fontFamily: {
            display: ['"Cinzel"', 'Georgia', 'serif'],
          },
        },
      },
    };
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&display=swap" rel="stylesheet" />
  <style>
    body { background-color: #0c0e14; }
    .bg-panel { background: linear-gradient(145deg, #161922, #1e2130); }
    .border-gold { border-color: #c8a96e40; }
    .divider { border-color: #c8a96e30; }
  </style>
</head>
<body class="min-h-screen flex flex-col items-center justify-center px-4 py-12">

  <!-- Background texture overlay -->
  <div class="fixed inset-0 opacity-5 pointer-events-none"
       style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23c8a96e\' fill-opacity=\'0.4\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');">
  </div>

  <div class="relative w-full max-w-md">

    <!-- Header -->
    <div class="text-center mb-8">
      <h1 class="font-display text-4xl font-bold text-gold mb-2 tracking-wide drop-shadow-lg">
        Account Portal
      </h1>
      <p class="text-slate-400 text-sm">Private WoW Realm &mdash; Members Only</p>
    </div>

    <!-- Card -->
    <div class="bg-panel rounded-2xl border border-gold p-8 shadow-2xl shadow-black/60">

      <% if (error) { %>
      <div class="mb-6 flex items-start gap-3 bg-red-900/30 border border-red-700/50 rounded-lg px-4 py-3">
        <svg class="w-5 h-5 text-red-400 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
        </svg>
        <p class="text-red-300 text-sm"><%= error %></p>
      </div>
      <% } %>

      <div class="text-center mb-8">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-slate-800 border border-gold/30 flex items-center justify-center">
          <svg class="w-8 h-8 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
              d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
          </svg>
        </div>
        <h2 class="font-display text-xl text-slate-200 mb-1">Members Only</h2>
        <p class="text-slate-500 text-sm leading-relaxed">
          Sign in with Discord to create or manage your game account.
          Access is restricted to members of our Discord server.
        </p>
      </div>

      <a href="/auth/discord"
         class="flex items-center justify-center gap-3 w-full bg-discord hover:bg-discord-hover text-white font-semibold py-3 px-6 rounded-xl transition-all duration-200 shadow-lg shadow-discord/20 hover:shadow-discord/40 group">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
        </svg>
        Sign in with Discord
        <svg class="w-4 h-4 opacity-0 group-hover:opacity-100 transition-opacity -ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>

      <% if (downloadUrl) { %>
      <hr class="divider my-6" />
      <div class="text-center">
        <p class="text-slate-500 text-xs mb-3">Already have an account?</p>
        <a href="<%= downloadUrl %>"
           class="inline-flex items-center gap-2 text-gold hover:text-gold-light text-sm font-medium transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
          Download Pre-configured Client
        </a>
      </div>
      <% } %>

    </div>

    <p class="text-center text-slate-700 text-xs mt-6">
      Not a member of the Discord? Ask your friends for an invite.
    </p>
  </div>

</body>
</html>
