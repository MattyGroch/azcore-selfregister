# === Discord OAuth ===
# From https://discord.com/developers/applications > Your App > OAuth2
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here
# Must match exactly what you set in Discord's "Redirects" list
DISCORD_REDIRECT_URI=https://register.yourdomain.com/auth/discord/callback
# The Guild (server) ID to gate access — right-click your server > Copy Server ID
DISCORD_GUILD_ID=your_guild_id_here

# === Account Proxy ===
# Base URL of the azcore-proxy service (no trailing slash)
PROXY_URL=https://ac-proxy.yourdomain.com
# Must match API_KEY in azcore-proxy/.env
PROXY_API_KEY=same_key_as_proxy

# === App Config ===
# Run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=generate_a_long_random_string_here

# Traefik: the public hostname this app will be served on
PORTAL_HOST=register.yourdomain.com

# Optional: direct download link for your pre-configured WoW client
CLIENT_DOWNLOAD_URL=https://your-file-host.com/wow-client.zip
# Optional: shown next to the download link on the dashboard (only visible to logged-in users)
CLIENT_DOWNLOAD_PASSWORD=

PORT=3000
